{
  "name": "telegram-signals-executor",
  "version": "1.0.0",
  "description": "Telegram crypto signals parser and exchange order executor",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy": "bash docker/deploy.sh",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "session": "ts-node scripts/generate-session.ts",
    "cli": "ts-node scripts/cli.ts",
    "replay": "ts-node scripts/simple-replay.ts start",
    "cleanup": "ts-node scripts/cleanup-data.ts"
  },
  "keywords": ["telegram", "crypto", "trading", "signals", "ccxt"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "telegram": "^2.19.10",
    "ccxt": "^4.1.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "prettier": "^3.1.0",
    "vitest": "^1.0.4",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
