FROM --platform=linux/arm64 node:22.12-slim

WORKDIR /app

COPY ../package*.json ./

RUN npm ci

COPY src/grid-bot/ ./grid-bot
COPY src/exchanges/ ./exchanges
COPY src/utils/ ./utils

EXPOSE 3000

ENV NODE_ENV=production

ENV PAIR_NAME=AMB/USDT
ENV LOWER_PRICE=0.0065
ENV UPPER_PRICE=0.0095
ENV GRID_STEP=0.0000273
ENV PRICE_PRECISION=7
ENV QUANTITY_PER_GRID=800
ENV MARKET_TYPE=linear
ENV IS_INFINITE_GRID=false
ENV LEVERAGE=5
ENV STOP_LOSS=0
ENV TAKE_PROFIT=0
ENV API_KEY=${API_KEY}
ENV API_SECRET=${API_SECRET}

# REDACTED

CMD ["node", "grid-bot/run.js"]
