FROM --platform=linux/arm64 node:22.12-slim

WORKDIR /app

# Install Python and build tools for native dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY src/ ./src/
COPY scripts/ ./scripts/

# Copy configuration files
COPY tsconfig.json ./

# Build the application
RUN npm run build

# Expose port (if needed for health checks)
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=production
ENV LOG_LEVEL=INFO

# Non-secret defaults. Credentials (TELEGRAM_*, EXCHANGE_API_*) are injected
# at runtime: ECS task definition, `docker run --env-file .env` or compose.
ENV EXCHANGE_ID=binanceusdm
ENV DEFAULT_LEVERAGE=5
ENV ORDER_SLIPPAGE_TOLERANCE=0.2
ENV MAX_SIGNAL_AGE_MS=120000
ENV TAKER_FEE=0.0005
ENV MAKER_FEE=0.0002

# Start the application
CMD ["node", "dist/index.js"]
